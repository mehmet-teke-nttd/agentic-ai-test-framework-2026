{
  "endpoints": [
    {
      "name": "Login",
      "basePath": "/api/v1",
      "relativePath": "/auth/login",
      "method": "POST",
      "authProfile": "none",
      "schemaAssertion": "schemas/auth-login-response.schema.json"
    },
    {
      "name": "GetProfile",
      "basePath": "/api/v1",
      "relativePath": "/users/me",
      "method": "GET",
      "authProfile": "bearer-user",
      "schemaAssertion": "schemas/user-profile-response.schema.json"
    }
  ]
}
